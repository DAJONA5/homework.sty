%%% Proofs %%%

%% counterexample --- a clone of the `proof' environment, using its
%% own \counterexname and \qefname.
%% Used to disprove "for all" propositions.
\NewDocumentEnvironment{counterexample}{+o}{%
  \NewCommandCopy\@oldqedname{\qedname}%
  \renewcommand\qedname{\qefname}%
  \begin{proof}[\counterexname]%
  \IfValueT{#1}{#1.\par}%
}{%
  \end{proof}%
  \RenewCommandCopy\qedname{\@oldqedname}%
}

%% example --- a clone of the `proof' environment, using its
%% own \examplename.
%% Used to prove "there exists" propositions.
\NewDocumentEnvironment{example}{+o}{%
  \begin{proof}[\examplename]%
  \IfValueT{#1}{#1.\par}%
}{\end{proof}}

\NewDocumentEnvironment{solution}{+o}{%
  \par\emph{\solutionname.}%
  \IfValueT{#1}{ #1.\par}%
}{}

%% induct --- a clone of the `proof' environment, inserting
%% \inductname and defining \bc (base case) and \ind (inductive
%% case).
\NewDocumentEnvironment{induct}{+o m}{%
  \providecommand\bc{}%
  \providecommand\ind{}%
  \providecommand\ih{}%
  \NewCommandCopy\@oldbc{\bc}%
  \NewCommandCopy\@oldind{\ind}%
  \NewCommandCopy\@oldih{\ih}%
  \renewcommand\bc{\emph{\basecasename}.}%
  \renewcommand\ind{\emph{\indcasename}.}%
  \renewcommand\ih{\ihname}%
  \IfNoValueTF{#1}{\begin{proof}}{\begin{proof}[#1]}%
  \inductname{} {#2}:\par%
}{%
  \end{proof}%
  \RenewCommandCopy\bc{\@oldbc}%
  \RenewCommandCopy\ind{\@oldind}%
  \RenewCommandCopy\ih{\@oldih}%
}

%% induct* --- like `induct', but doesn't insert \inductname.
\NewDocumentEnvironment{induct*}{+o}{%
  \IfNoValueTF{#1}{\begin{proof}}{\begin{proof}[#1]}%
  \NewCommandCopy\@oldbc{\bc}%
  \NewCommandCopy\@oldind{\ind}%
  \NewCommandCopy\@oldih{\ih}%
  \newcommand\bc{\emph{\basecasename}.}%
  \newcommand\ind{\emph{\indcasename}.}%
  \newcommand\ih{\ihname}%
}{%
  \end{proof}%
  \RenewCommandCopy\bc{\@oldbc}%
  \RenewCommandCopy\ind{\@oldind}%
  \RenewCommandCopy\ih{\@oldih}%
}

