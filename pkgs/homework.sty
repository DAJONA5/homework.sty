%%% Configuration

%% Languages & Fonts
\bool_if:NT \l__homework_babel_bool {
  \babelfont{rm}[Ligatures=TeX]{TeX~Gyre~Pagella}
  \babelfont{sf}[Ligatures=TeX]{TeX~Gyre~Heros}
  \babelfont{tt}{Noto~Sans~Mono}

  \seq_new:N \l__homework_tmphebrewrm_seq
  \seq_new:N \l__homework_tmphebrewsf_seq
  \seq_new:N \l__homework_tmphebrewtt_seq

  \clist_map_inline:Nn \l__homework_babel_hebrewrm_clist {
    \seq_put_right:Ne \l__homework_tmphebrewrm_seq {
      " \lua_escape:e {#1} "
    }
  }

  \clist_map_inline:Nn \l__homework_babel_hebrewsf_clist {
    \seq_put_right:Ne \l__homework_tmphebrewsf_seq {
      " \lua_escape:e {#1} "
    }
  }

  \clist_map_inline:Nn \l__homework_babel_hebrewtt_clist {
    \seq_put_right:Ne \l__homework_tmphebrewtt_seq {
      " \lua_escape:e {#1} "
    }
  }

  \bool_lazy_any:nTF {
    { \seq_if_empty_p:N \l__homework_tmphebrewrm_seq }
    { \seq_if_empty_p:N \l__homework_tmphebrewsf_seq }
    { \seq_if_empty_p:N \l__homework_tmphebrewtt_seq }
  } {
    \babelfont[hebrew]{rm}{David~CLM}
    \babelfont[hebrew]{sf}{Nachlieli~CLM}
    \babelfont[hebrew]{tt}{Liberation~Mono}
  } {
    \lua_now:e{
      local~ function~ font_found(name)~
        local~ foundname, subfont = luaotfload.aux.resolve_fontname(name)~
        return~ (foundname~ and~ true)~ or~ false~
      end~

      local~ function~ make_fallback(names)~
        local~ result = {}~
        for~ _, name~ in~ ipairs(names)~ do~
          if~ font_found(name)~ then~
            table.insert(result, "name:" .. name .. ":mode=harf")~
          end~
        end~
        return~ result~
      end~

      luaotfload.add_fallback("hebrewrm", make_fallback({
        \seq_use:Nn \l__homework_tmphebrewrm_seq {,}
      }))~

      luaotfload.add_fallback("hebrewsf", make_fallback({
        \seq_use:Nn \l__homework_tmphebrewsf_seq {,}
      }))~

      luaotfload.add_fallback("hebrewtt", make_fallback({
        \seq_use:Nn \l__homework_tmphebrewtt_seq {,}
      }))~
    }

    \babelfont
      [hebrew]
      {rm}
      [RawFeature={fallback=hebrewrm}]
      { \clist_item:Nn \l__homework_babel_hebrewrm_clist {1} }

    \babelfont
      [hebrew]
      {sf}
      [RawFeature={fallback=hebrewsf}]
      { \clist_item:Nn \l__homework_babel_hebrewsf_clist {1} }

    \babelfont
      [hebrew]
      {tt}
      [RawFeature={fallback=hebrewtt}]
      { \clist_item:Nn \l__homework_babel_hebrewtt_clist {1} }
  }
}

