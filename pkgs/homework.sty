%% CLRScode
\RenewDocumentCommand\li{}{
  \legacy_if_gset_true:n { numberedline }
  \legacy_if:nTF { firstcodeline }{
    \legacy_if_gset_false:n { firstcodeline }
  }{
    \\
  }

  \refstepcounter{codelinenumber}
  \liprint
}

\RenewDocumentCommand\lispace{m}{
  \legacy_if:nTF { firstcodeline } {
    \legacy_if_gset_false:n { firstcodeline }
  }{
    \\[#1]
  }

