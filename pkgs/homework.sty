\IfBooleanT{\@homework@titling}{
  %% Set the number, course, due date, etc.
  %% Using \NewDocumentCommand to get optimized robust commands
  \NewDocumentCommand\mmnnum{m}{\gdef\@homework@mmnnum{#1}}
  \NewDocumentCommand\coursen{m}{\gdef\@homework@coursen{#1}}
  \NewDocumentCommand\course{m}{\gdef\@homework@course{#1}}
  \NewDocumentCommand\semester{m}{\gdef\@homework@semester{#1}}
  \NewDocumentCommand\duedate{m m m}{\gdef\@homework@duedate%
    {\localedate{#1}{#2}{#3}}}

  %% Document Structure
  \NewDocumentEnvironment{preface}{o}{%
    \subsection*{{\protect\sffamily \IfNoValueTF{#1}{\prefacename}{#1}}}%
    \sffamily%
  }{}
  \newcommand\mainsection{\section*{\protect\qsectionname}}
}

